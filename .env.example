# Application
APP_NAME=AI Visual Inspection Framework
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql://inspection_user:inspection_password@localhost:5432/ai_inspection

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Model
MODEL_PATH=backend/weights/road_damage_model.pt
MODEL_VERSION=smallresnet-v1
DEMO_MODE=true

# File Uploads
UPLOAD_DIR=backend/uploads
OUTPUT_DIR=backend/outputs
MAX_UPLOAD_SIZE=10485760

# Road Damage Classes (comma-separated)
DAMAGE_CLASSES=pothole,longitudinal_crack,transverse_crack,alligator_crack,surface_damage,no_damage

# Severity Levels (comma-separated)
SEVERITY_LEVELS=low,medium,high

# Image Processing
IMAGE_SIZE=224,224
NORMALIZATION_MEAN=0.485,0.456,0.406
NORMALIZATION_STD=0.229,0.224,0.225
